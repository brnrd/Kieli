# Choose demo (development only), local (built-in accounts), okta (OIDC), or saml.
# In local mode, initialize an admin with npm run users:bootstrap -- --email ... --name ...
AUTH_MODE=demo
APP_ORIGIN=http://localhost:4321
STORAGE_DRIVER=sqlite
SQLITE_PATH=.data/keylo.sqlite

# Production: AUTH_MODE=local, okta, or saml; STORAGE_DRIVER=dynamodb; HTTPS APP_ORIGIN.
# Okta-only settings below. Built-in accounts need no identity provider or SESSION_SECRET.
# OKTA_ISSUER=https://your-org.okta.com/oauth2/default
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=
# OKTA_SCOPES=openid profile email groups
# SESSION_SECRET=                         # openssl rand -hex 32
# DYNAMODB_TABLE=keylo
# AWS_REGION=eu-west-1
# AWS guided installer: set by CloudFormation; not needed for operator CLI bootstrap.
# KEYLO_INSTALL_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT:secret:...
# Development-only installer fixture: 48 alphanumeric characters. Ignored in production.
# KEYLO_INSTALL_TOKEN=

# SAML-only: exact values from the trusted identity-provider configuration.
# SAML_ENTRY_POINT=https://example.okta.com/app/YOUR_APP/sso/saml
# SAML_IDP_ISSUER=http://www.okta.com/YOUR_APP_ID
# SAML_SP_ENTITY_ID=https://copy.example.com/auth/saml/metadata
# For local operator setup, quoted PEM values support escaped newlines.
# SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# SAML_SP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SAML_SP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# On AWS, load all three PEM fields from Secrets Manager instead of environment values.
# SAML_SECRETS_ARN=arn:aws:secretsmanager:REGION:ACCOUNT:secret:keylo-saml-...

# Automatic project snapshots (Node/Docker). Run npm run snapshots:run every five minutes.
# Set the same random secret on the server and operator scheduler; never expose it to clients.
# KEYLO_SNAPSHOT_JOB_TOKEN=                 # openssl rand -hex 32
# AWS templates configure their own generated secret and EventBridge runner.
# KEYLO_SNAPSHOT_JOB_SECRET_ARN=
