NODE_ENV=production
AUTH_MODE=local
APP_ORIGIN=https://copy.example.com
HOST=127.0.0.1
PORT=8080
STORAGE_DRIVER=sqlite
SQLITE_PATH=/var/lib/kieli/kieli.sqlite
# For snapshots/reconciliation, generate a random token and configure it here
# and in the host scheduler's protected environment. Do not commit the value.
# KIELI_SNAPSHOT_JOB_TOKEN=
