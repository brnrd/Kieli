{
  "name": "keylo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --import tsx --test tests/*.test.*",
    "smoke": "node scripts/smoke.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:saml": "node --import tsx scripts/smoke-saml.mjs",
    "smoke:sso": "node --import tsx scripts/smoke-saml.mjs --scim",
    "seed": "node --env-file-if-exists=.env --import tsx src/scripts/seed.ts",
    "users:bootstrap": "node --env-file-if-exists=.env --import tsx src/scripts/users.ts bootstrap",
    "users:recover": "node --env-file-if-exists=.env --import tsx src/scripts/users.ts recover",
    "cli": "node cli/keylo.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "package:aws": "node scripts/package-aws.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "prebuild": "node scripts/package-sdks.mjs",
    "snapshots:run": "node --env-file-if-exists=.env scripts/snapshots.mjs",
    "identities:reconcile": "node --env-file-if-exists=.env scripts/snapshots.mjs identities",
    "smoke:features": "node scripts/smoke-features.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.2",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@babel/parser": "^7.29.12",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@node-rs/argon2": "^2.2.2",
    "@node-saml/node-saml": "5.2.0",
    "@xmldom/xmldom": "0.8.15",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "astro": "^7.4.4",
    "cldr-core": "^48.2.0",
    "fflate": "^0.8.3",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "openid-client": "^6.8.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/nft": "1.11.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "xml-crypto": "6.4.0"
  },
  "overrides": {
    "@vercel/nft": {
      "glob": "14.0.3"
    },
    "glob": {
      "minimatch": "11.0.3"
    }
  }
}
