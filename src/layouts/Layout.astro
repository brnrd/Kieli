---
import '../styles/global.css';
import '../styles/dense.css';
import '../styles/accounts.css';
import '../styles/theme.css';
import '../styles/mcp.css';
import '../styles/messages.css';
import '../styles/glossary.css';
import ThemeScript from '../components/ThemeScript.astro';
interface Props { title?: string }
const { title = 'Kieli — Translation management' } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="light" data-appearance="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A focused, open-source workspace for your product copy and translations." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fafbf9" />
    <ThemeScript />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
